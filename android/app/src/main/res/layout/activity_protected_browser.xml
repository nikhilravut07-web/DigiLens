<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#6366F1"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DigiLens Protected Viewer"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:gravity="center" />

        <View
            android:layout_width="48dp"
            android:layout_height="1dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- URL Bar Header Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/card_background"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hostTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="example.com"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/urlTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://example.com"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace" />

        </LinearLayout>

        <TextView
            android:id="@+id/riskBadgeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROTECTED"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#16A34A"
            android:background="@drawable/badge_background"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Warning / Blocked Banner -->
    <LinearLayout
        android:id="@+id/warningBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/warning_card_background"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/warningTitleView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navigation Blocked"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#DC2626" />

        <TextView
            android:id="@+id/warningDescView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reason..."
            android:textSize="12sp"
            android:textColor="#0F172A"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/backToSafetyButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Back to Safety"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_background"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
